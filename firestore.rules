rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    // Marketing staff: not admins (no client data at all) -- only the ads.
    function isMarketing() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'marketing';
    }

    // The IB a client is tagged with at signup must match the partner link
    // they used (or be the built-in Retail fallback when no link resolved),
    // so a client can't hand-pick an IB, product or MT5 group.
    function ibConsistent(d) {
      return ('ib_link_code' in d) && (
        (d.ib_link_code == null && d.ib_id == 'retail' && d.product_id == null && d.mt5_group == null) ||
        (d.ib_link_code != null
          && exists(/databases/$(database)/documents/ib_links/$(d.ib_link_code))
          && get(/databases/$(database)/documents/ib_links/$(d.ib_link_code)).data.ib_id == d.ib_id
          && get(/databases/$(database)/documents/ib_links/$(d.ib_link_code)).data.main_ib_id == d.main_ib_id
          && get(/databases/$(database)/documents/ib_links/$(d.ib_link_code)).data.product_id == d.product_id
          && get(/databases/$(database)/documents/ib_links/$(d.ib_link_code)).data.mt5_group == d.mt5_group)
      );
    }

    // Admin-editable operational settings (e.g. the Whish Money number).
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Staff activity log -- append-only in practice.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isMarketing();
    }

    // Marketing ads shown on the homepage and in the portal. Anyone
    // (signed in or not) can read an ad that's switched on -- the site
    // queries `where active == true` -- while drafts and switched-off ads
    // stay visible to staff only.
    match /ads/{adId} {
      allow get, list: if resource.data.active == true || isAdmin() || isMarketing();
      allow create, update, delete: if isAdmin() || isMarketing();
    }

    // IB records (main IBs and sub-IBs, with their products). Staff only.
    match /ibs/{ibId} {
      allow read, write: if isAdmin();
    }

    // One doc per partner link (the code in ?ib=CODE), plus a '_default'
    // alias for signups with no link. A signed-in client can read the one
    // code they arrived with, but can't list them all.
    match /ib_links/{code} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // Product catalog (MT5 groups) imported from the Backoffice, picked from
    // when giving an IB its products. Staff only.
    match /products/{productId} {
      allow read, write: if isAdmin();
    }

    // Log of clients moved from one IB to another. Staff only, append-only.
    match /ib_moves/{moveId} {
      allow read, create: if isAdmin();
    }

    match /funding_requests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.approved_amount == null
        && request.resource.data.resolved_by == null;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolved_by == null;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      function unchanged(field) {
        return !(field in request.resource.data.diff(resource.data).affectedKeys());
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();

      // Signup: client creates their own doc with safe starting values and
      // an IB tag that matches their partner link -- OR an admin creates a
      // fully-formed client doc directly.
      allow create: if isAdmin() || (
        isOwner()
        && request.resource.data.uid == userId
        && (!('is_admin' in request.resource.data) || request.resource.data.is_admin == false)
        && !('role' in request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.mt5_login == null
        && request.resource.data.mt5_password == null
        && ibConsistent(request.resource.data)
      );

      // Self-service updates: only KYC submission and MT5 account requests,
      // never touching privileged fields -- including the IB tag, which only
      // staff can change (and every change is logged in ib_moves).
      allow update: if isAdmin() || (
        isOwner() &&
        unchanged('is_admin') &&
        unchanged('role') &&
        unchanged('mt5_login') &&
        unchanged('mt5_password') &&
        unchanged('mt5_server') &&
        unchanged('mt5_accounts') &&
        unchanged('mt5_history') &&
        unchanged('last_rebate_amount') &&
        unchanged('last_rebate_paid_at') &&
        unchanged('rebate_history') &&
        unchanged('referral_code') &&
        unchanged('referral_count') &&
        unchanged('referral_credited') &&
        unchanged('rejection_reason') &&
        unchanged('created_by') &&
        unchanged('email') &&
        unchanged('uid') &&
        unchanged('ib_link_code') &&
        unchanged('ib_id') &&
        unchanged('ib_name') &&
        unchanged('ib_code') &&
        unchanged('main_ib_id') &&
        unchanged('main_ib_name') &&
        unchanged('main_ib_code') &&
        unchanged('product_id') &&
        unchanged('product_name') &&
        unchanged('mt5_group') &&
        unchanged('ib_assigned_at') &&
        unchanged('terms_accepted_at') &&
        (
          // Submitting or resubmitting KYC documents
          (resource.data.status in ['pending', 'pending_kyc', 'kyc_rejected'] &&
           request.resource.data.status == 'kyc_submitted') ||
          // Requesting an MT5 account once KYC is approved
          (resource.data.status == 'kyc_approved' &&
           request.resource.data.status == 'mt5_requested') ||
          // Requesting an additional account once active -- 3 accounts max
          (resource.data.status == 'active' &&
           request.resource.data.status == 'mt5_requested' &&
           (!('mt5_accounts' in resource.data) || resource.data.mt5_accounts.size() < 3))
        )
      );

      allow delete: if isAdmin();
    }
  }
}
